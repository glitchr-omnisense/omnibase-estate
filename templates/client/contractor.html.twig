{% extends '@Estate/client/layout.html.twig' %}

{% block estate_title %}{{ '@estate.contractor.title'|trans }}{% endblock %}
{% block estate_eyebrow %}<p class="estate-eyebrow">{{ contractors|map(c => c.company ~ ' · ' ~ c.organisation.name)|join(' — ') }}</p>{% endblock %}
{% block estate_lead %}{{ '@estate.contractor.lead'|trans }}{% endblock %}
{% block estate_class %}estate-space estate-contractor{% endblock %}

{% block estate_content %}
{% set open = orders|filter(o => o.status.isOpen and o.status.value != 'done') %}
<div class="estate-tiles">
    <div class="estate-tile{{ open|length ? ' is-alert' }}"><span>{{ '@estate.contractor.open'|trans }}</span><strong>{{ open|length }}</strong><small>{{ '@estate.contractor.open_detail'|trans }}</small></div>
    <div class="estate-tile"><span>{{ '@estate.contractor.done_count'|trans }}</span><strong>{{ orders|filter(o => o.status.value in ['done', 'closed'])|length }}</strong><small>{{ '@estate.contractor.done_detail'|trans }}</small></div>
</div>
<section class="estate-panel">
    <h2>{{ '@estate.contractor.jobs'|trans }}</h2>
    {% if orders %}
    <table class="estate-table">
        <thead><tr><th>{{ '@estate.contractor.job'|trans }}</th><th>{{ '@estate.contractor.where'|trans }}</th><th>{{ '@estate.contractor.when'|trans }}</th><th>{{ '@estate.tenant.state'|trans }}</th></tr></thead>
        <tbody>
        {% for order in orders %}
            <tr>
                <td><a href="{{ path('estate_work_order', {id: order.id}) }}"><strong>{{ order.title }}</strong></a><small>#{{ order.id }} · {{ order.category }}{% if order.urgency.value == 'urgent' %} · <b class="is-urgent">{{ '@estate.urgency.urgent'|trans }}</b>{% endif %}</small></td>
                <td>{{ order.unit.name }}<small>{{ order.unit.address }}, {{ order.unit.city }}</small></td>
                <td>{{ order.visitAt ? order.visitAt|format_datetime('medium', 'short') : '—' }}</td>
                <td><span class="estate-status is-{{ order.status.value }}">{{ ('@estate.work.' ~ order.status.value)|trans }}</span></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p class="estate-empty">{{ '@estate.contractor.none'|trans }}</p>
    {% endif %}
</section>
{% endblock %}
