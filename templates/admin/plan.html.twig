{% extends '@Admin/layout.html.twig' %}

{% block page_title %}Plan — {{ unit.name }}{% endblock %}

{% block content_header %}
<div class="admin-header">
    <span class="admin-header-icon"><i class="fa-solid fa-ruler-combined"></i></span>
    <div class="admin-header-titles">
        <h1>Plan — {{ unit.name }}</h1>
        <div class="admin-header-subtitle">{{ unit.district ?: unit.city }}{% if unit.door %} · {{ unit.door }}{% endif %} · surface déclarée {{ unit.surface ? unit.surface|m2 : 'non renseignée' }}</div>
    </div>
</div>
{% endblock %}

{% block content %}
{#
 # The plan editor (public/js/plan-editor.js): rooms drawn as rectangles on a 10 cm grid, moved,
 # their corners dragged, merged into an L or split along a line; named, given a kind and a level,
 # their measured figure typed (it prevails); an architect's plan traced over, scaled by two points
 # and a known length. Saved as JSON (PlanController::save()).
 #}
<style>
    .estate-plan-editor { display: grid; grid-template-columns: minmax(0, 1fr) 19rem; gap: 1rem; align-items: start; }
    @media (max-width: 960px) { .estate-plan-editor { grid-template-columns: minmax(0, 1fr); } }
    .estate-plan-editor .card { padding: .9rem 1rem; }
    .estate-plan-toolbar { display: flex; flex-wrap: wrap; gap: .35rem; align-items: center; margin-bottom: .6rem; }
    .estate-plan-toolbar .btn { padding: .3rem .6rem; font-size: .85rem; }
    .estate-plan-toolbar .btn[aria-pressed="true"] { background: var(--admin-primary, #1e3a5f); color: #fff; border-color: transparent; }
    .estate-plan-toolbar .sep { width: 1px; align-self: stretch; background: var(--admin-border, #ddd); margin: 0 .2rem; }
    .estate-plan-levels { display: flex; flex-wrap: wrap; gap: .3rem; margin-bottom: .6rem; }
    .estate-plan-levels button { font-size: .8rem; padding: .15rem .55rem; border-radius: 999px; border: 1px solid var(--admin-border, #ccc); background: transparent; }
    .estate-plan-levels button[aria-pressed="true"] { background: var(--admin-primary, #1e3a5f); color: #fff; border-color: transparent; }
    .estate-plan-stage { position: relative; height: min(70vh, 44rem); min-height: 22rem; border: 1px solid var(--admin-border, #ddd); border-radius: 6px; overflow: hidden; background: #fbfbfa; touch-action: none; user-select: none; }
    .estate-plan-stage svg { display: block; width: 100%; height: 100%; }
    .estate-plan-stage.is-rect, .estate-plan-stage.is-split-v, .estate-plan-stage.is-split-h, .estate-plan-stage.is-scale { cursor: crosshair; }
    .estate-plan-stage .room polygon { fill: rgba(30, 58, 95, .07); stroke: #1f2328; stroke-width: 2.5; vector-effect: non-scaling-stroke; cursor: move; }
    .estate-plan-stage .room.is-uncounted polygon { fill: rgba(120, 120, 120, .12); stroke-dasharray: 6 4; }
    .estate-plan-stage .room.is-selected polygon { fill: rgba(208, 49, 45, .12); stroke: #d0312d; }
    .estate-plan-stage .room.is-other-level { pointer-events: none; opacity: .25; }
    .estate-plan-stage .room text { pointer-events: none; fill: #1f2328; text-anchor: middle; }
    .estate-plan-stage .room text .is-measured { font-style: italic; }
    .estate-plan-stage .handle { fill: #fff; stroke: #d0312d; stroke-width: 2; vector-effect: non-scaling-stroke; cursor: grab; }
    .estate-plan-stage .draft { fill: rgba(208, 49, 45, .1); stroke: #d0312d; stroke-dasharray: 6 4; stroke-width: 2; vector-effect: non-scaling-stroke; }
    .estate-plan-stage .split-line { stroke: #d0312d; stroke-width: 2; stroke-dasharray: 8 5; vector-effect: non-scaling-stroke; }
    .estate-plan-stage .scale-point { fill: #d0312d; }
    .estate-plan-stage .size-tip { position: absolute; left: .5rem; bottom: .5rem; padding: .15rem .45rem; border-radius: 4px; background: rgba(31, 35, 40, .82); color: #fff; font-size: .78rem; pointer-events: none; }
    .estate-plan-side { display: grid; gap: .75rem; }
    .estate-plan-side label { display: grid; gap: .2rem; font-size: .85rem; font-weight: 600; }
    .estate-plan-side .check { display: flex; gap: .45rem; align-items: center; font-weight: 500; }
    .estate-plan-side h2 { font-size: 1rem; margin: 0 0 .5rem; }
    .estate-plan-side dl { display: grid; grid-template-columns: 1fr auto; gap: .2rem .75rem; margin: 0; font-size: .88rem; }
    .estate-plan-side dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }
    .estate-plan-gap { margin: .5rem 0 0; padding: .45rem .6rem; border-radius: 4px; background: #fff4e5; color: #8a4b00; font-size: .85rem; }
    .estate-plan-status { font-size: .82rem; color: var(--admin-muted, #666); }
    .estate-plan-status.is-error { color: #b42318; }
    .estate-plan-help { font-size: .8rem; color: var(--admin-muted, #666); margin: .5rem 0 0; }
    .estate-plan-help kbd { font-size: .72rem; }
</style>

<div class="estate-plan-editor" data-estate-plan-editor
     data-save-url="{{ path('estate_admin_plan_save', {id: unit.id}) }}"
     data-token="{{ csrf_token('estate_plan_' ~ unit.id) }}"
     data-background="{{ unit.planBackground ? path('estate_admin_plan_background_image', {id: unit.id}) ~ '?v=' ~ unit.planBackgroundScale|default(0) : '' }}">
    <script type="application/json" data-plan>{{ plan|json_encode|raw }}</script>
    <script type="application/json" data-kinds>{{ kinds|map(k => {value: k.value, label: ('@estate.room.' ~ k.value)|trans, counted: k.countsByDefault})|json_encode|raw }}</script>

    <div class="card">
        <div class="estate-plan-toolbar" role="toolbar" aria-label="Outils du plan">
            <button type="button" class="btn btn-secondary" data-tool="select" aria-pressed="true" title="Choisir, déplacer, tirer un coin (S)"><i class="fa-solid fa-arrow-pointer"></i> Choisir</button>
            <button type="button" class="btn btn-secondary" data-tool="rect" aria-pressed="false" title="Tracer une pièce rectangulaire (R)"><i class="fa-regular fa-square"></i> Pièce</button>
            <button type="button" class="btn btn-secondary" data-tool="split-v" aria-pressed="false" title="Couper une pièce verticalement"><i class="fa-solid fa-grip-lines-vertical"></i> Couper ↕</button>
            <button type="button" class="btn btn-secondary" data-tool="split-h" aria-pressed="false" title="Couper une pièce horizontalement"><i class="fa-solid fa-grip-lines"></i> Couper ↔</button>
            <button type="button" class="btn btn-secondary" data-action="merge" disabled title="Réunir les pièces choisies (Maj + clic) en une seule"><i class="fa-solid fa-object-group"></i> Réunir</button>
            <span class="sep"></span>
            <button type="button" class="btn btn-secondary" data-action="undo" disabled title="Annuler (Ctrl+Z)"><i class="fa-solid fa-rotate-left"></i></button>
            <button type="button" class="btn btn-secondary" data-action="zoom-in" title="Zoomer"><i class="fa-solid fa-magnifying-glass-plus"></i></button>
            <button type="button" class="btn btn-secondary" data-action="zoom-out" title="Dézoomer"><i class="fa-solid fa-magnifying-glass-minus"></i></button>
            <button type="button" class="btn btn-secondary" data-action="fit" title="Tout voir"><i class="fa-solid fa-expand"></i></button>
            <span class="sep"></span>
            <button type="button" class="btn btn-success" data-action="save"><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button>
            <span class="estate-plan-status" data-status role="status"></span>
        </div>
        <div class="estate-plan-levels" data-levels></div>
        <div class="estate-plan-stage" data-stage>
            <svg data-svg xmlns="http://www.w3.org/2000/svg" aria-label="Plan de {{ unit.name }}" role="application"></svg>
            <span class="size-tip" data-tip hidden></span>
        </div>
        <p class="estate-plan-help">Grille de 10 cm. <kbd>R</kbd> pièce · <kbd>S</kbd> choisir · <kbd>Maj</kbd>+clic : plusieurs pièces · double-clic sur un mur : un coin de plus · <kbd>Suppr</kbd> retire la pièce · molette : zoom · glisser le fond : déplacer la vue.</p>
    </div>

    <div class="estate-plan-side">
        <div class="card" data-room-panel hidden>
            <h2>Pièce</h2>
            <div style="display: grid; gap: .6rem">
                <label>Nom<input class="form-control form-control-sm" data-field="name" maxlength="80"></label>
                <label>Type<select class="form-select form-select-sm" data-field="kind"></select></label>
                <label>Niveau<input class="form-control form-control-sm" type="number" data-field="level" min="-5" max="50" step="1"></label>
                <label>Surface mesurée (m²)<input class="form-control form-control-sm" data-field="measured" inputmode="decimal" placeholder=""><small class="text-muted" data-drawn></small></label>
                <label class="check"><input type="checkbox" data-field="counted"> Comptée dans la surface habitable (Carrez)</label>
                <button type="button" class="btn btn-sm btn-outline-danger" data-action="delete"><i class="fa-solid fa-trash"></i> Retirer la pièce</button>
            </div>
        </div>

        <div class="card">
            <h2>Surfaces</h2>
            <dl data-totals></dl>
            <p class="estate-plan-gap" data-gap hidden></p>
            <p class="estate-plan-help">Plan privé : seuls les locataires du bail en cours, la gestion, les associés et les propriétaires du bien le voient ; jamais le public.</p>
        </div>

        <div class="card">
            <h2>Plan d'architecte</h2>
            <form method="post" action="{{ path('estate_admin_plan_background', {id: unit.id}) }}" enctype="multipart/form-data" style="display: grid; gap: .5rem">
                <input type="hidden" name="_token" value="{{ csrf_token('estate_plan_' ~ unit.id) }}">
                <input class="form-control form-control-sm" type="file" name="background" accept="image/*{{ readsPdf ? ',application/pdf' }}" required>
                <button class="btn btn-sm btn-secondary" type="submit"><i class="fa-solid fa-upload"></i> {{ unit.planBackground ? 'Remplacer' : 'Ajouter' }} {{ readsPdf ? '(image ou PDF)' : '(image)' }}</button>
            </form>
            {% if unit.planBackground %}
            <div style="display: grid; gap: .5rem; margin-top: .75rem">
                <button type="button" class="btn btn-sm btn-secondary" data-tool="scale" aria-pressed="false"><i class="fa-solid fa-ruler"></i> Mettre à l'échelle</button>
                <p class="estate-plan-help" data-scale-help>Cliquez deux points du plan dont vous connaissez la distance (une cote, un mur), puis donnez-la.</p>
                <label>Longueur connue (cm)<input class="form-control form-control-sm" type="number" data-scale-length min="1" step="1" placeholder="par ex. 420"></label>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: .4rem">
                    <label>Décalage x (cm)<input class="form-control form-control-sm" type="number" data-bg="x" step="10"></label>
                    <label>Décalage y (cm)<input class="form-control form-control-sm" type="number" data-bg="y" step="10"></label>
                </div>
                <label>Opacité<input type="range" min="10" max="100" value="45" data-bg-opacity></label>
                <form method="post" action="{{ path('estate_admin_plan_background', {id: unit.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('estate_plan_' ~ unit.id) }}">
                    <button class="btn btn-sm btn-link text-danger" name="remove" value="1"><i class="fa-solid fa-xmark"></i> Retirer le plan d'architecte</button>
                </form>
            </div>
            {% endif %}
        </div>
        <p><a href="{{ path('admin_crud_units_edit', {entityId: unit.id}) }}"><i class="fa-solid fa-arrow-left"></i> Fiche du bien</a></p>
    </div>
</div>
<script src="{{ asset('bundles/estate/js/plan-editor.js') }}"></script>
{% endblock %}
