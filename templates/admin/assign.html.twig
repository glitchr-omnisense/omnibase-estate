{% extends '@Admin/layout.html.twig' %}

{% block page_title %}Confier #{{ order.id }}{% endblock %}

{% block content_header %}
<div class="admin-header">
    <span class="admin-header-icon"><i class="fa-solid fa-helmet-safety"></i></span>
    <div class="admin-header-titles">
        <h1>Confier « {{ order.title }} »</h1>
        <div class="admin-header-subtitle">{{ order.unit.name }} · {{ order.category }} · signalé le {{ order.createdAt|format_date('long') }}</div>
    </div>
</div>
{% endblock %}

{% block content %}
<style>
    .estate-admin-form { display: grid; gap: 1rem; max-width: 40rem; }
    .estate-admin-form .card { padding: 1rem 1.25rem; }
    .estate-admin-form form { display: grid; gap: .9rem; }
    .estate-admin-form label { display: grid; gap: .3rem; font-weight: 600; }
</style>
<div class="estate-admin-form">
    <div class="card"><p style="white-space: pre-line; margin: 0">{{ order.description }}</p></div>
    <form method="post" class="card">
        <input type="hidden" name="_token" value="{{ csrf_token('estate_assign_' ~ order.id) }}">
        <label>Artisan
            <select class="form-select" name="contractor" required>
                {% for c in contractors %}<option value="{{ c.id }}" {{ order.contractor == c ? 'selected' }}>{{ c.trade }} — {{ c.company }}</option>{% endfor %}
            </select>
        </label>
        <label>Passage convenu (facultatif)<input class="form-control" type="datetime-local" name="visitAt" value="{{ order.visitAt ? order.visitAt|date('Y-m-d\\TH:i') }}"></label>
        <label>Un mot pour l'artisan (facultatif)<textarea class="form-control" name="note" rows="3"></textarea></label>
        <p class="text-muted">L'artisan reçoit l'intervention par e-mail et la retrouve dans son espace ; le locataire est prévenu.</p>
        <div><button class="btn btn-primary" type="submit"><i class="fa-solid fa-paper-plane"></i> Confier</button></div>
    </form>
</div>
{% endblock %}
