{% extends '@Estate/pdf/_document.html.twig' %}
{% set st = statement %}
{% set title = 'Compte rendu de gérance ' ~ st.periodLabel ~ ' — ' ~ st.name %}
{% block recipient %}<strong>{{ mandator.name }}</strong>{% if mandator.fullAddress %}<br>{{ mandator.fullAddress }}{% endif %}{% if mandator.email %}<br>{{ mandator.email }}{% endif %}<br>Mandat {{ mandate.number ?? '—' }}{% endblock %}
{% block document %}
<h1>Compte rendu de gérance</h1>
<div class="ref">{{ st.periodLabel|capitalize }} · du {{ st.from|format_date('long') }} au {{ st.to|format_date('long') }} · mandat {{ mandate.number ?? '—' }} depuis le {{ mandate.startsOn|format_date('long') }}</div>

<table class="amounts">
    <tr><td>Solde au {{ st.from|date_modify('-1 day')|format_date('long') }}</td><td class="num">{{ st.opening|euros }}</td></tr>
</table>

<h3 style="margin: 4mm 0 1mm">Loyers par bien</h3>
<table class="amounts">
    {% for row in st.units %}<tr><td>{{ row.unit.name }}{% if row.unit.address %} <span class="muted">· {{ row.unit.address }}{% if row.unit.door %}, {{ row.unit.door }}{% endif %}</span>{% endif %}<br><span class="muted">appelés {{ row.called|euros }}</span></td><td class="num">{{ row.collected|euros }}</td></tr>{% else %}<tr><td class="muted">Aucun bien sous mandat.</td><td></td></tr>{% endfor %}
    <tr class="total"><td>Loyers et charges encaissés <span class="muted">(appelés {{ st.called|euros }})</span></td><td class="num">{{ st.collected|euros }}</td></tr>
</table>
{% if st.rentLines %}
<table class="amounts">
    {% for line in st.rentLines %}<tr><td class="muted">{{ line.date|format_date('short') }} · {{ line.unit.name }} · {{ line.label }}</td><td class="num muted">{{ line.amount|euros }}</td></tr>{% endfor %}
</table>
{% endif %}

<h3 style="margin: 4mm 0 1mm">Honoraires de gestion ({{ mandate.feeLabel }} HT des encaissements)</h3>
<table class="amounts">
    {% for line in st.feeLines %}<tr><td>{{ line.date|format_date('short') }} · {{ line.label }} <span class="muted">({{ line.amount|euros }} HT{% if line.vat %} + TVA {{ line.vat|euros }}{% endif %})</span></td><td class="num">- {{ line.total|euros }}</td></tr>{% else %}<tr><td class="muted">Aucun honoraire sur la période.</td><td></td></tr>{% endfor %}
    <tr class="total"><td>Total des honoraires <span class="muted">({{ st.feesExcludingTax|euros }} HT, TVA {{ st.feesVat|euros }})</span></td><td class="num">- {{ st.fees|euros }}</td></tr>
</table>

<h3 style="margin: 4mm 0 1mm">Dépenses pour votre compte</h3>
<table class="amounts">
    {% for line in st.expenseLines %}<tr><td>{{ line.date|format_date('short') }} · {{ line.label }}</td><td class="num">- {{ line.amount|euros }}</td></tr>{% else %}<tr><td class="muted">Aucune dépense sur la période.</td><td></td></tr>{% endfor %}
    <tr class="total"><td>Total des dépenses</td><td class="num">- {{ st.expenses|euros }}</td></tr>
</table>

<h3 style="margin: 4mm 0 1mm">Reversements</h3>
<table class="amounts">
    {% for line in st.payoutLines %}<tr><td>{{ line.date|format_date('short') }} · {{ line.label }}{% if line.payout.iban %} <span class="muted">vers {{ line.payout.iban|slice(0, 4) }} … {{ line.payout.iban|slice(-4) }}</span>{% endif %}</td><td class="num">- {{ line.amount|euros }}</td></tr>{% else %}<tr><td class="muted">Aucun reversement sur la période.</td><td></td></tr>{% endfor %}
    <tr class="total"><td>Total des reversements</td><td class="num">- {{ st.payouts|euros }}</td></tr>
</table>

<table class="amounts">
    <tr class="total"><td>Solde au {{ st.to|format_date('long') }} {{ st.closing > 0 ? '(en votre faveur)' : (st.closing < 0 ? '(à votre charge)' : '') }}</td><td class="num">{{ st.closing|euros }}</td></tr>
    {% if mandate.reserve %}<tr><td class="muted">Réserve conservée pour les dépenses à venir</td><td class="num muted">{{ mandate.reserve|euros }}</td></tr>{% endif %}
    <tr><td>Disponible pour reversement</td><td class="num">{{ st.available|euros }}</td></tr>
</table>

{% if st.unpaid %}
<h3 style="margin: 4mm 0 1mm">Loyers restant dus par les locataires</h3>
<table class="amounts">
    {% for row in st.unpaid %}<tr><td>{{ row.call.lease.unit.name }} · {{ row.call.period|format_date(pattern: 'MMMM yyyy') }} · {{ row.call.lease.tenantNames }}</td><td class="num">{{ row.remaining|euros }}</td></tr>{% endfor %}
    <tr class="total"><td>Total restant dû <span class="muted">(non compris dans votre solde)</span></td><td class="num">{{ st.unpaid|reduce((sum, r) => sum + r.remaining, 0)|euros }}</td></tr>
</table>
{% endif %}

<p class="note">Les loyers vous sont acquis une fois encaissés ; les sommes sont détenues pour votre compte sur le compte séquestre de l'agence{% if organisation.iban %} ({{ organisation.name }}){% endif %}. Honoraires : {{ mandate.feeLabel }} hors taxes des loyers et charges encaissés, TVA en sus lorsque l'agence y est assujettie. Dépenses : les factures réglées pour vos biens, toutes taxes comprises.</p>
<div class="sign">Établi à {{ organisation.city ?? 'Strasbourg' }}, le {{ 'now'|format_date('long') }}<br><strong>{{ organisation.name }}</strong>, mandataire</div>
{% endblock %}
