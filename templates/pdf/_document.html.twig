{# A rent notice or receipt, as a printable page (dompdf turns it into a PDF): the company, the tenant, the amounts. #}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>{{ title }}</title>
<style>
    @page { margin: 22mm 18mm; }
    body { font-family: Helvetica, Arial, sans-serif; font-size: 10.5pt; color: #14171c; }
    .top { width: 100%; margin-bottom: 14mm; }
    .top td { vertical-align: top; width: 50%; }
    .brand { font-size: 15pt; font-weight: bold; }
    .brand span { color: #d0312d; }
    .muted { color: #5d636b; font-size: 9pt; }
    h1 { font-size: 17pt; margin: 0 0 2mm; }
    .ref { color: #5d636b; margin-bottom: 8mm; }
    table.amounts { width: 100%; border-collapse: collapse; margin: 6mm 0; }
    table.amounts td { padding: 2.5mm 0; border-bottom: .3mm solid #e2e4e1; }
    table.amounts td.num { text-align: right; }
    table.amounts tr.total td { font-weight: bold; border-bottom: .6mm solid #14171c; }
    .note { margin-top: 10mm; font-size: 9pt; color: #5d636b; }
    .sign { margin-top: 14mm; }
</style>
</head>
<body>
<table class="top"><tr>
    <td><div class="brand">{{ organisation.name|replace({'&': '<span>&amp;</span>'})|raw }}</div><div class="muted">{{ organisation.legalForm }}{% if organisation.siren %} · SIREN {{ organisation.siren }}{% endif %}<br>{{ organisation.fullAddress }}<br>{{ organisation.email }}</div></td>
    <td style="text-align: right"><strong>{{ lease.tenantNames }}</strong><br>{{ lease.unit.address }}{% if lease.unit.door %}, {{ lease.unit.door }}{% endif %}<br>{{ lease.unit.postcode }} {{ lease.unit.city }}</td>
</tr></table>
{% block document %}{% endblock %}
</body>
</html>
